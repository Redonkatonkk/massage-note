model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  source            String
  action            String
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id") @db.Uuid
  businessDate      DateTime? @map("business_date") @db.Date
  beforeJson        Json?    @map("before_json")
  afterJson         Json?    @map("after_json")
  reason            String?
  requestId         String   @map("request_id")
  idempotencyKeyHash String? @map("idempotency_key_hash")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([storeId, entityType, entityId])
  @@index([storeId, businessDate])
  @@map("audit_logs")
}

model IdempotencyRequest {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  key          String
  route        String
  requestHash  String   @map("request_hash")
  status       String
  responseCode Int?     @map("response_code")
  responseJson Json?    @map("response_json")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, userId, key, route])
  @@index([expiresAt])
  @@map("idempotency_requests")
}

model DomainOutbox {
  id            String       @id @default(uuid()) @db.Uuid
  storeId       String       @map("store_id") @db.Uuid
  topic         String
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payloadJson   Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  lastError     String?      @map("last_error")
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([status, createdAt])
  @@index([storeId, createdAt])
  @@map("domain_outbox")
}

model AiConversation {
  id            String          @id @default(uuid()) @db.Uuid
  storeId       String          @map("store_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  assistantType AiAssistantType @map("assistant_type")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastMessageAt DateTime        @default(now()) @map("last_message_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  logs  AiQueryLog[]

  @@index([storeId, userId, lastMessageAt])
  @@map("ai_conversations")
}

model AiQueryLog {
  id                      String   @id @default(uuid()) @db.Uuid
  conversationId          String   @map("conversation_id") @db.Uuid
  storeId                 String   @map("store_id") @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  modelProvider           String   @map("model_provider")
  modelName               String   @map("model_name")
  inputText               String   @map("input_text")
  toolCallsJson           Json?    @map("tool_calls_json")
  toolResultsRedactedJson Json?    @map("tool_results_redacted_json")
  outcome                 String
  latencyMs               Int      @map("latency_ms")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id])
  store        Store          @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@map("ai_query_logs")
}

model AiChangePreview {
  id                   String          @id @default(uuid()) @db.Uuid
  storeId              String          @map("store_id") @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  operation            String
  canonicalPayloadJson Json            @map("canonical_payload_json")
  baseVersionsJson     Json            @map("base_versions_json")
  warningsJson         Json            @map("warnings_json")
  status               AiPreviewStatus @default(PENDING)
  expiresAt            DateTime        @map("expires_at") @db.Timestamptz(3)
  confirmedAt          DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  consumedAt           DateTime?       @map("consumed_at") @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, userId, status, expiresAt])
  @@map("ai_change_previews")
}
