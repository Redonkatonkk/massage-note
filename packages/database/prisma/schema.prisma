generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StoreStatus {
  SETUP
  ACTIVE
  DELETED
}

enum MembershipRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum DispatchKind {
  REGULAR
  CLIENT_REQUESTED
  STORE_ASSIGNED
}

enum DispatchIntentStatus {
  PENDING
  CONSUMED
  CANCELLED
}

enum DispatchMakeupStatus {
  PENDING
  CONSUMED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkRecordStatus {
  PENDING_PAYMENT
  CONFIRMED
}

enum ClosingStatus {
  CLOSED
  CANCELLED
}

enum ClosingImageLocale {
  zh_CN
  en_US
}

enum ClosingDeliveryStatus {
  QUEUED
  CLAIMED
  SENT
  FAILED
  CANCELLED
}

enum ClosingDeliveryKind {
  INITIAL
  RESEND
}

enum CashSettlementStatus {
  UNSETTLED
  SETTLED
}

enum ItemType {
  SERVICE
  ADDON
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum AiAssistantType {
  WORK_RECORD
  FINANCE
}

enum AiPreviewStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  firebaseUid String     @unique @map("firebase_uid")
  phoneE164   String     @unique @map("phone_e164")
  passwordHash String?   @map("password_hash")
  firstName   String?    @map("first_name")
  lastName    String?    @map("last_name")
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships StoreMembership[]
  joinRequests StoreJoinRequest[]
  aiConversations AiConversation[]

  @@map("users")
}

model Store {
  id                                       String      @id @default(uuid()) @db.Uuid
  storeCode                                String      @unique @map("store_code") @db.Char(6)
  name                                     String
  timezone                                 String
  businessCutoffLocal                      String      @map("business_cutoff_local") @db.VarChar(5)
  globalCommissionBps                      Int         @map("global_commission_bps")
  mondayThursdayAutoDiscountEnabled        Boolean     @default(false) @map("monday_thursday_auto_discount_enabled")
  mondayThursdayAutoDiscountThresholdCents BigInt      @default(0) @map("monday_thursday_auto_discount_threshold_cents")
  mondayThursdayAutoDiscountAmountCents    BigInt      @default(0) @map("monday_thursday_auto_discount_amount_cents")
  giftCardAutoDiscountEnabled               Boolean     @default(false) @map("gift_card_auto_discount_enabled")
  giftCardAutoDiscountThresholdCents        BigInt      @default(0) @map("gift_card_auto_discount_threshold_cents")
  giftCardAutoDiscountBps                   Int         @default(0) @map("gift_card_auto_discount_bps")
  automaticDispatchEnabled                 Boolean     @default(false) @map("automatic_dispatch_enabled")
  nextGiftCardSerialNumber                 Int         @default(1001) @map("gift_card_next_serial_number")
  closingDefaultLocale                    ClosingImageLocale @default(zh_CN) @map("closing_default_locale")
  ownerMembershipId                        String?     @unique @map("owner_membership_id") @db.Uuid
  status                                   StoreStatus @default(SETUP)
  version                                  Int         @default(1)
  deletedAt                                DateTime?   @map("deleted_at") @db.Timestamptz(3)
  deletedBy                                String?     @map("deleted_by") @db.Uuid
  deleteReason                             String?     @map("delete_reason")
  createdAt                                DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                                DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          StoreMembership[]
  ownerMembership      StoreMembership?  @relation("StoreOwnerMembership", fields: [ownerMembershipId], references: [id])
  joinRequests         StoreJoinRequest[]
  shifts               Shift[]
  dailyBoards          DailyBoard[]
  serviceItems         ServiceItem[]
  addonItems           AddonItem[]
  discountItems        DiscountItem[]
  workRecords          WorkRecord[]
  giftCardSales        GiftCardSale[]
  closings             BusinessDayClosing[]
  closingDeliveries    EmployeeClosingDelivery[]
  settlementDeliveries EmployeeSettlementDelivery[]
  closingDeliveryAgent ClosingDeliveryAgent?
  cashSettlements      DailyCashSettlement[]
  payrollSettlements   PayrollSettlement[]
  audits               AuditLog[]
  idempotencyRequests  IdempotencyRequest[]
  outboxEvents         DomainOutbox[]
  aiConversations      AiConversation[]
  aiQueryLogs          AiQueryLog[]
  aiChangePreviews     AiChangePreview[]
  dispatchIntents      DispatchIntent[]
  dispatchMakeups      DispatchMakeupTurn[]
  dispatchEvents       DispatchEvent[]

  @@index([status])
  @@map("stores")
}

model StoreMembership {
  id                    String           @id @default(uuid()) @db.Uuid
  storeId               String           @map("store_id") @db.Uuid
  userId                String?          @map("user_id") @db.Uuid
  role                  MembershipRole
  displayName           String           @map("display_name")
  displayNameNormalized String           @map("display_name_normalized")
  isServiceProvider     Boolean          @default(true) @map("is_service_provider")
  employmentType        EmploymentType?  @map("employment_type")
  defaultCommissionBps  Int?             @map("default_commission_bps")
  closingDeliveryEnabled Boolean         @default(false) @map("closing_delivery_enabled")
  closingDeliveryPhoneE164 String?       @map("closing_delivery_phone_e164")
  closingImageLocale    ClosingImageLocale? @map("closing_image_locale")
  status                MembershipStatus @default(ACTIVE)
  joinedAt              DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt                DateTime?        @map("left_at") @db.Timestamptz(3)
  version               Int              @default(1)
  deletedAt             DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deletedBy             String?          @map("deleted_by") @db.Uuid
  deleteReason          String?          @map("delete_reason")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  store                 Store            @relation(fields: [storeId], references: [id])
  ownedStore            Store?           @relation("StoreOwnerMembership")
  user                  User?            @relation(fields: [userId], references: [id])
  shifts                Shift[]
  dailyRows             DailyEmployeeRow[]
  employeeDefaultCommissions EmployeeDefaultCommission[]
  employeeItemCommissions EmployeeItemCommission[]
  workRecords           WorkRecord[]
  operatedGiftCardSales GiftCardSale[]
  cashSettlements       DailyCashSettlement[]
  payrollSettlements    PayrollSettlement[]
  closingDeliveries     EmployeeClosingDelivery[]
  settlementDeliveries  EmployeeSettlementDelivery[]
  dispatchIntents       DispatchIntent[]
  dispatchMakeups       DispatchMakeupTurn[]
  dispatchEvents        DispatchEvent[]

  @@unique([storeId, userId])
  @@index([storeId, status])
  @@index([storeId, displayNameNormalized])
  @@map("store_memberships")
}

model StoreJoinRequest {
  id                   String            @id @default(uuid()) @db.Uuid
  storeId              String            @map("store_id") @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  requestedDisplayName String            @map("requested_display_name")
  status               JoinRequestStatus @default(PENDING)
  reviewedBy           String?           @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewNote            String?           @map("review_note")
  version               Int               @default(1)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([storeId, status])
  @@index([userId, status])
  @@map("store_join_requests")
}

model Shift {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  businessDate DateTime  @map("business_date") @db.Date
  clockInAt    DateTime  @map("clock_in_at") @db.Timestamptz(3)
  clockOutAt   DateTime? @map("clock_out_at") @db.Timestamptz(3)
  createdBy    String    @map("created_by") @db.Uuid
  updatedBy    String    @map("updated_by") @db.Uuid
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  store      Store           @relation(fields: [storeId], references: [id])
  membership StoreMembership @relation(fields: [membershipId], references: [id])

  @@index([storeId, businessDate])
  @@index([membershipId, clockOutAt])
  @@map("shifts")
}

model DailyBoard {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  version      Int      @default(1)
  rankedAt     DateTime? @map("ranked_at") @db.Timestamptz(3)
  dispatchSequence Int  @default(0) @map("dispatch_sequence")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])
  rows  DailyEmployeeRow[]
  dispatchIntents DispatchIntent[]
  dispatchMakeups DispatchMakeupTurn[]
  dispatchEvents  DispatchEvent[]

  @@unique([storeId, businessDate])
  @@map("daily_boards")
}

model DailyEmployeeRow {
  id           String   @id @default(uuid()) @db.Uuid
  boardId      String   @map("board_id") @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  position     Decimal  @db.Decimal(20, 10)
  isHidden     Boolean  @default(false) @map("is_hidden")
  normalTurnsProcessed Int @default(0) @map("normal_turns_processed")
  crossedTurns Int @default(0) @map("crossed_turns")
  rotationRankedAt DateTime? @map("rotation_ranked_at") @db.Timestamptz(3)
  addedBy      String   @map("added_by") @db.Uuid
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  board      DailyBoard      @relation(fields: [boardId], references: [id])
  membership StoreMembership @relation(fields: [membershipId], references: [id])

  @@unique([boardId, membershipId])
  @@index([storeId, position])
  @@map("daily_employee_rows")
}

model DispatchIntent {
  id                   String               @id @default(uuid()) @db.Uuid
  boardId              String               @map("board_id") @db.Uuid
  storeId              String               @map("store_id") @db.Uuid
  employeeMembershipId String               @map("employee_membership_id") @db.Uuid
  kind                 DispatchKind
  status               DispatchIntentStatus @default(PENDING)
  sequence             Int
  boardVersion         Int                  @map("board_version")
  workRecordId         String?              @unique @map("work_record_id") @db.Uuid
  consumedMakeupTurnId String?              @unique @map("consumed_makeup_turn_id") @db.Uuid
  createdBy            String               @map("created_by") @db.Uuid
  consumedAt           DateTime?            @map("consumed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  board      DailyBoard      @relation(fields: [boardId], references: [id])
  store      Store           @relation(fields: [storeId], references: [id])
  employee   StoreMembership @relation(fields: [employeeMembershipId], references: [id])
  workRecord WorkRecord?     @relation(fields: [workRecordId], references: [id])

  @@index([boardId, status, sequence])
  @@index([storeId, employeeMembershipId, status])
  @@map("dispatch_intents")
}

model DispatchMakeupTurn {
  id                   String               @id @default(uuid()) @db.Uuid
  boardId              String               @map("board_id") @db.Uuid
  storeId              String               @map("store_id") @db.Uuid
  employeeMembershipId String               @map("employee_membership_id") @db.Uuid
  status               DispatchMakeupStatus @default(PENDING)
  reason               String
  sequence             Int
  sourceWorkRecordId   String?              @map("source_work_record_id") @db.Uuid
  consumedWorkRecordId String?              @map("consumed_work_record_id") @db.Uuid
  consumedAt           DateTime?            @map("consumed_at") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  board      DailyBoard      @relation(fields: [boardId], references: [id])
  store      Store           @relation(fields: [storeId], references: [id])
  employee   StoreMembership @relation(fields: [employeeMembershipId], references: [id])

  @@index([boardId, status, sequence])
  @@index([employeeMembershipId, status])
  @@map("dispatch_makeup_turns")
}

model DispatchEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  boardId              String   @map("board_id") @db.Uuid
  storeId              String   @map("store_id") @db.Uuid
  employeeMembershipId String?  @map("employee_membership_id") @db.Uuid
  sequence             Int
  kind                 String
  detailJson           Json?    @map("detail_json")
  workRecordId         String?  @map("work_record_id") @db.Uuid
  actorUserId          String   @map("actor_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  board    DailyBoard       @relation(fields: [boardId], references: [id])
  store    Store            @relation(fields: [storeId], references: [id])
  employee StoreMembership? @relation(fields: [employeeMembershipId], references: [id])

  @@unique([boardId, sequence])
  @@index([storeId, createdAt])
  @@map("dispatch_events")
}

model ServiceItem {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  fullName             String    @map("full_name")
  shortName            String    @map("short_name")
  durationMinutes      Int       @map("duration_minutes")
  priceCents           BigInt    @map("price_cents")
  defaultCommissionBps Int?      @map("default_commission_bps")
  position             Int
  isEnabled            Boolean   @default(true) @map("is_enabled")
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy            String?   @map("deleted_by") @db.Uuid
  deleteReason         String?   @map("delete_reason")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])
  priceOptions ServiceItemPriceOption[]

  @@index([storeId, isEnabled, position])
  @@map("service_items")
}

model ServiceItemPriceOption {
  id              String   @id @default(uuid()) @db.Uuid
  serviceItemId   String   @map("service_item_id") @db.Uuid
  durationMinutes Int      @map("duration_minutes")
  priceCents      BigInt   @map("price_cents")
  position        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@unique([serviceItemId, durationMinutes])
  @@index([serviceItemId, position])
  @@map("service_item_price_options")
}

model AddonItem {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  name                 String
  shortName            String    @map("short_name")
  amountCents          BigInt    @map("amount_cents")
  durationMinutes      Int?      @map("duration_minutes")
  defaultCommissionBps Int?      @map("default_commission_bps")
  position             Int
  isEnabled            Boolean   @default(true) @map("is_enabled")
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy            String?   @map("deleted_by") @db.Uuid
  deleteReason         String?   @map("delete_reason")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, isEnabled, position])
  @@map("addon_items")
}

model DiscountItem {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  name         String
  shortName    String    @map("short_name")
  amountCents  BigInt    @map("amount_cents")
  position     Int
  isEnabled    Boolean   @default(true) @map("is_enabled")
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, isEnabled, position])
  @@map("discount_items")
}

model EmployeeDefaultCommission {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  commissionBps Int      @map("commission_bps")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(3)
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership StoreMembership @relation(fields: [membershipId], references: [id])

  @@index([storeId, membershipId, effectiveFrom])
  @@map("employee_default_commissions")
}

model EmployeeItemCommission {
  id            String    @id @default(uuid()) @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  membershipId  String    @map("membership_id") @db.Uuid
  itemType      ItemType  @map("item_type")
  itemId        String    @map("item_id") @db.Uuid
  commissionBps Int       @map("commission_bps")
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(3)
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  membership StoreMembership @relation(fields: [membershipId], references: [id])

  @@index([storeId, membershipId, itemType, itemId, effectiveFrom])
  @@map("employee_item_commissions")
}

model WorkRecord {
  id                              String           @id @default(uuid()) @db.Uuid
  storeId                         String           @map("store_id") @db.Uuid
  employeeMembershipId            String           @map("employee_membership_id") @db.Uuid
  businessDate                    DateTime         @map("business_date") @db.Date
  storeTimezoneSnapshot           String           @map("store_timezone_snapshot")
  businessCutoffSnapshot          String           @map("business_cutoff_snapshot") @db.VarChar(5)
  startAt                         DateTime         @map("start_at") @db.Timestamptz(3)
  endAt                           DateTime?        @map("end_at") @db.Timestamptz(3)
  actualDurationMinutes           Int?             @map("actual_duration_minutes")
  status                          WorkRecordStatus @default(PENDING_PAYMENT)
  mainServiceAmountCents          BigInt           @map("main_service_amount_cents")
  addonTotalCents                 BigInt           @default(0) @map("addon_total_cents")
  grossFeeBaseCents               BigInt           @map("gross_fee_base_cents")
  discountTotalCents              BigInt           @default(0) @map("discount_total_cents")
  discountedFeePerformanceCents  BigInt           @map("discounted_fee_performance_cents")
  cashServiceCents                BigInt?          @map("cash_service_cents")
  cardServiceCents                BigInt?          @map("card_service_cents")
  giftCardSerialNumber            String?          @map("gift_card_serial_number")
  giftCardServiceCents            BigInt?          @map("gift_card_service_cents")
  cashTipCents                    BigInt?          @map("cash_tip_cents")
  cardTipCents                    BigInt?          @map("card_tip_cents")
  giftCardTipCents                BigInt?          @map("gift_card_tip_cents")
  totalTipCents                   BigInt?          @map("total_tip_cents")
  actualServiceCollectedCents     BigInt?          @map("actual_service_collected_cents")
  customerTotalPaidCents          BigInt?          @map("customer_total_paid_cents")
  paymentDifferenceCents          BigInt?          @map("payment_difference_cents")
  mainServiceWageCents            BigInt           @map("main_service_wage_cents")
  addonWageCents                  BigInt           @default(0) @map("addon_wage_cents")
  totalLargeFeeWageCents          BigInt           @map("total_large_fee_wage_cents")
  employeeTotalIncomeCents        BigInt?          @map("employee_total_income_cents")
  cashAllocatedServiceWageCents   BigInt?          @map("cash_allocated_service_wage_cents")
  cashAcquiredServiceWageCents    BigInt?          @map("cash_acquired_service_wage_cents")
  cashWageShortfallCents          BigInt?          @map("cash_wage_shortfall_cents")
  tipSettledManualFlag            Boolean          @default(false) @map("tip_settled_manual_flag")
  largeFeeSettledManualFlag       Boolean          @default(false) @map("large_fee_settled_manual_flag")
  automaticDiscountSuppressed     Boolean          @default(false) @map("automatic_discount_suppressed")
  isHighlighted                   Boolean          @default(false) @map("is_highlighted")
  dispatchKind                    DispatchKind?    @map("dispatch_kind")
  manualPriceFlag                 Boolean          @default(false) @map("manual_price_flag")
  note                            String           @default("")
  version                         Int              @default(1)
  deletedAt                       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deletedBy                       String?          @map("deleted_by") @db.Uuid
  deleteReason                    String?          @map("delete_reason")
  createdBy                       String           @map("created_by") @db.Uuid
  updatedBy                       String           @map("updated_by") @db.Uuid
  createdAt                       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  store           Store                      @relation(fields: [storeId], references: [id])
  employee        StoreMembership            @relation(fields: [employeeMembershipId], references: [id])
  serviceSnapshot WorkRecordServiceSnapshot?
  addonSnapshots  WorkRecordAddonSnapshot[]
  discountSnapshots WorkRecordDiscountSnapshot[]
  payment         PaymentBreakdown?
  dispatchIntent  DispatchIntent?

  @@index([storeId, businessDate, startAt])
  @@index([storeId, employeeMembershipId, businessDate])
  @@index([storeId, isHighlighted, businessDate])
  @@index([storeId, status])
  @@map("work_records")
}

model WorkRecordServiceSnapshot {
  id                  String  @id @default(uuid()) @db.Uuid
  workRecordId        String  @unique @map("work_record_id") @db.Uuid
  sourceServiceItemId String? @map("source_service_item_id") @db.Uuid
  isCustom            Boolean @map("is_custom")
  name                String
  shortName           String  @map("short_name")
  amountCents         BigInt  @map("amount_cents")
  durationMinutes     Int     @map("duration_minutes")
  commissionBps       Int     @map("commission_bps")
  commissionSource    String  @map("commission_source")
  wageCents           BigInt  @map("wage_cents")

  workRecord WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)

  @@map("work_record_service_snapshots")
}

model WorkRecordAddonSnapshot {
  id                String  @id @default(uuid()) @db.Uuid
  workRecordId      String  @map("work_record_id") @db.Uuid
  sourceAddonItemId String? @map("source_addon_item_id") @db.Uuid
  isCustom          Boolean @map("is_custom")
  name              String
  shortName         String  @map("short_name")
  amountCents       BigInt  @map("amount_cents")
  durationMinutes   Int?    @map("duration_minutes")
  commissionBps     Int     @map("commission_bps")
  commissionSource  String  @map("commission_source")
  wageCents         BigInt  @map("wage_cents")
  position          Int

  workRecord WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)

  @@index([workRecordId, position])
  @@map("work_record_addon_snapshots")
}

model WorkRecordDiscountSnapshot {
  id                   String  @id @default(uuid()) @db.Uuid
  workRecordId         String  @map("work_record_id") @db.Uuid
  sourceDiscountItemId String? @map("source_discount_item_id") @db.Uuid
  isCustom             Boolean @map("is_custom")
  isAutomatic          Boolean @default(false) @map("is_automatic")
  name                 String
  amountCents          BigInt  @map("amount_cents")
  position             Int

  workRecord WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)

  @@index([workRecordId, position])
  @@map("work_record_discount_snapshots")
}

model PaymentBreakdown {
  id                 String    @id @default(uuid()) @db.Uuid
  workRecordId       String    @unique @map("work_record_id") @db.Uuid
  cashServiceCents   BigInt?   @map("cash_service_cents")
  cardServiceCents   BigInt?   @map("card_service_cents")
  giftCardSerialNumber String? @map("gift_card_serial_number")
  giftCardServiceCents BigInt? @map("gift_card_service_cents")
  cashTipCents       BigInt?   @map("cash_tip_cents")
  cardTipCents       BigInt?   @map("card_tip_cents")
  giftCardTipCents   BigInt?   @map("gift_card_tip_cents")
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedBy        String?   @map("confirmed_by") @db.Uuid
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workRecord WorkRecord @relation(fields: [workRecordId], references: [id], onDelete: Cascade)

  @@map("payment_breakdowns")
}

model GiftCardSale {
  id                     String    @id @default(uuid()) @db.Uuid
  storeId                String    @map("store_id") @db.Uuid
  businessDate           DateTime  @map("business_date") @db.Date
  serialNumber           String    @map("serial_number")
  serialNumberNormalized String    @map("serial_number_normalized")
  faceValueCents         BigInt    @map("face_value_cents")
  discountThresholdCents BigInt    @default(0) @map("discount_threshold_cents")
  discountRateBps        Int       @default(0) @map("discount_rate_bps")
  discountCents          BigInt    @default(0) @map("discount_cents")
  cashCents              BigInt    @default(0) @map("cash_cents")
  cardCents              BigInt    @default(0) @map("card_cents")
  amountCents            BigInt    @map("amount_cents")
  operatorMembershipId   String    @map("operator_membership_id") @db.Uuid
  version                Int       @default(1)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy              String?   @map("deleted_by") @db.Uuid
  deleteReason           String?   @map("delete_reason")
  createdBy              String    @map("created_by") @db.Uuid
  updatedBy              String    @map("updated_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  store    Store           @relation(fields: [storeId], references: [id])
  operator StoreMembership @relation(fields: [operatorMembershipId], references: [id])

  @@index([storeId, businessDate, createdAt])
  @@index([storeId, serialNumberNormalized])
  @@index([operatorMembershipId, businessDate])
  @@map("gift_card_sales")
}

model BusinessDayClosing {
  id                  String        @id @default(uuid()) @db.Uuid
  storeId             String        @map("store_id") @db.Uuid
  businessDate        DateTime      @map("business_date") @db.Date
  cycleNo             Int           @map("cycle_no")
  status              ClosingStatus @default(CLOSED)
  isForced            Boolean       @default(false) @map("is_forced")
  forceReason         String?       @map("force_reason")
  warningSnapshotJson Json          @map("warning_snapshot_json")
  totalsSnapshotJson  Json          @map("totals_snapshot_json")
  closedBy            String        @map("closed_by") @db.Uuid
  closedAt            DateTime      @default(now()) @map("closed_at") @db.Timestamptz(3)
  cancelledBy         String?       @map("cancelled_by") @db.Uuid
  cancelledAt         DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  version             Int           @default(1)

  store      Store                     @relation(fields: [storeId], references: [id])
  deliveries EmployeeClosingDelivery[]

  @@unique([storeId, businessDate, cycleNo])
  @@index([storeId, businessDate, status])
  @@map("business_day_closings")
}

model EmployeeClosingDelivery {
  id                    String                @id @default(uuid()) @db.Uuid
  storeId               String                @map("store_id") @db.Uuid
  closingId             String                @map("closing_id") @db.Uuid
  membershipId          String                @map("membership_id") @db.Uuid
  kind                   ClosingDeliveryKind
  status                 ClosingDeliveryStatus @default(QUEUED)
  recipientPhoneE164     String                @map("recipient_phone_e164")
  locale                 ClosingImageLocale
  snapshotJson           Json                  @map("snapshot_json")
  queuedBy               String                @map("queued_by") @db.Uuid
  requestKey             String?               @map("request_key")
  attemptCount           Int                   @default(0) @map("attempt_count")
  leaseToken             String?               @map("lease_token") @db.Uuid
  leaseExpiresAt         DateTime?              @map("lease_expires_at") @db.Timestamptz(3)
  nextAttemptAt          DateTime               @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastErrorCode          String?                @map("last_error_code")
  lastError              String?                @map("last_error")
  sentAt                 DateTime?              @map("sent_at") @db.Timestamptz(3)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  store      Store              @relation(fields: [storeId], references: [id])
  closing    BusinessDayClosing @relation(fields: [closingId], references: [id])
  membership StoreMembership    @relation(fields: [membershipId], references: [id])

  @@unique([storeId, closingId, membershipId, kind, requestKey])
  @@index([status, nextAttemptAt, createdAt])
  @@index([storeId, closingId, createdAt])
  @@index([storeId, membershipId, createdAt])
  @@map("employee_closing_deliveries")
}

model EmployeeSettlementDelivery {
  id                    String                 @id @default(uuid()) @db.Uuid
  storeId               String                 @map("store_id") @db.Uuid
  membershipId          String?                @map("membership_id") @db.Uuid
  documentType          String                 @default("RANGE_SETTLEMENT") @map("document_type")
  periodStart           DateTime               @map("period_start") @db.Date
  periodEnd             DateTime               @map("period_end") @db.Date
  paymentScope          String                 @map("payment_scope")
  status                ClosingDeliveryStatus  @default(QUEUED)
  recipientPhoneE164    String                 @map("recipient_phone_e164")
  locale                ClosingImageLocale
  snapshotJson          Json                   @map("snapshot_json")
  queuedBy              String                 @map("queued_by") @db.Uuid
  requestKey            String                 @map("request_key")
  attemptCount          Int                    @default(0) @map("attempt_count")
  leaseToken            String?                @map("lease_token") @db.Uuid
  leaseExpiresAt        DateTime?               @map("lease_expires_at") @db.Timestamptz(3)
  nextAttemptAt         DateTime                @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  summarySentAt         DateTime?               @map("summary_sent_at") @db.Timestamptz(3)
  detailSentAt          DateTime?               @map("detail_sent_at") @db.Timestamptz(3)
  lastErrorCode         String?                 @map("last_error_code")
  lastError             String?                @map("last_error")
  sentAt                DateTime?               @map("sent_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  store      Store           @relation(fields: [storeId], references: [id])
  membership StoreMembership? @relation(fields: [membershipId], references: [id])

  @@unique([storeId, requestKey])
  @@index([status, nextAttemptAt, createdAt])
  @@index([storeId, membershipId, createdAt])
  @@map("employee_settlement_deliveries")
}

